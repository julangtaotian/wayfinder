plugins/frontend-ai-workflow/runtime/playwright/node_modules/.cache/
plugins/frontend-ai-workflow/runtime/playwright/node_modules/**/.cache/
plugins/frontend-ai-workflow/runtime/playwright/node_modules/.DS_Store
plugins/frontend-ai-workflow/runtime/playwright/node_modules/**/.DS_Store

# 工具缓存与增量构建状态；不要宽泛忽略 dist、build 或 outputs
.cache/
.turbo/
.vite/
.parcel-cache/
.sass-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 单平台插件成品由确定性发布入口重建，不提交暂存 marketplace
/dist/frontend-ai-workflow-*/
/dist/frontend-ai-workflow-*.stage-*/

# 测试、覆盖率和通用浏览器报告；持久 UI 验收记录仍需提交
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
/outputs/frontend-test-runtime/
/outputs/verify-runtime/
/outputs/validator-runtime/
/outputs/verification-evidence-integrity/
/outputs/verification-evidence/
/outputs/platform-runtime-delivery/
/outputs/real-project-validation/local-matrix.json
/outputs/real-project-validation/test-fixtures/
