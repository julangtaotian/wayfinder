    "test": "node scripts/test-groups.mjs all",
    "test:repository": "node scripts/test-groups.mjs repository",
    "test:workflow": "node scripts/test-groups.mjs workflow",
    "test:platform": "node scripts/test-groups.mjs platform",
    "validate": "node plugins/frontend-ai-workflow/scripts/validate-structure.mjs",
    "openspec:version": "node plugins/frontend-ai-workflow/scripts/openspec-cli.mjs --version",
    "verify": "node scripts/verify.mjs",
    "verify:shared": "node scripts/verify.mjs --scope shared",
    "verify:platform": "node scripts/verify.mjs --scope platform",
    "requirements:archive": "node plugins/frontend-ai-workflow/scripts/requirement-archive.mjs",
    "footprint": "node plugins/frontend-ai-workflow/scripts/repository-footprint.mjs"
