{
  "name": "frontend-ai-workflow",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "Team marketplace and Codex plugin for reusable frontend AI workflows.",
  "scripts": {
    "prepare:test-runtime": "node scripts/prepare-frontend-test-runtime.mjs",
    "cleanup:test-runtime": "node scripts/cleanup-frontend-test-runtime.mjs",
    "cleanup:test-cache": "node scripts/cleanup-frontend-test-runtime.mjs --cache",
    "test": "node scripts/test-groups.mjs all",
    "test:repository": "node scripts/test-groups.mjs repository",
    "test:workflow": "node scripts/test-groups.mjs workflow",
    "test:platform": "node scripts/test-groups.mjs platform",
    "check:static": "node scripts/static-check.mjs",
    "validate": "node plugins/frontend-ai-workflow/scripts/validate-structure.mjs",
    "validate:official": "node scripts/official-validator-preflight.mjs",
    "cleanup:official-validator-cache": "node scripts/official-validator-preflight.mjs --cleanup-cache",
    "openspec:version": "node plugins/frontend-ai-workflow/scripts/openspec-cli.mjs --version",
    "verify": "node scripts/verify.mjs",
    "verify:shared": "node scripts/verify.mjs --scope shared",
    "verify:platform": "node scripts/verify.mjs --scope platform",
    "benchmark:developer-effectiveness": "node plugins/frontend-ai-workflow/scripts/developer-effectiveness-benchmark.mjs",
    "requirements:archive": "node plugins/frontend-ai-workflow/scripts/requirement-archive.mjs",
    "footprint": "node plugins/frontend-ai-workflow/scripts/repository-footprint.mjs",
    "lifecycle:audit": "node plugins/frontend-ai-workflow/scripts/lifecycle-audit.mjs",
    "lifecycle:status": "node plugins/frontend-ai-workflow/scripts/lifecycle-status.mjs",
    "lifecycle:migrate": "node plugins/frontend-ai-workflow/scripts/lifecycle-migration.mjs",
    "context:stage": "node plugins/frontend-ai-workflow/scripts/stage-context.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
